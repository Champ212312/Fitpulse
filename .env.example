# Copy to .env and replace every value before running outside a local machine.
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/fitpulse.sqlite
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
MAX_CAPACITY=50
# Bootstrap accounts are created once on first startup if the email is unused.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace-with-a-strong-staff-password
